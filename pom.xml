<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.akka</groupId>
        <artifactId>akka-javasdk-parent</artifactId>
        <version>3.6.3</version>
    </parent>
    <groupId>io.akka</groupId>
    <artifactId>redash-akka</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>redash-akka</name>

    <dependencies>
        <!-- The JDBC drivers this rebuild ships. Every data source type redash registers is
             built, and each one says which driver class and URL it needs; a type whose driver
             is not on the classpath still appears in the registry, still validates its
             configuration and still builds its connection string, and answers the driver's own
             "no suitable driver" when asked to run something. These four cover ten of the
             seventy-five: pg, redshift, redshift_iam, cockroach, risingwave, mysql, rds_mysql,
             memsql, mssql, mssql_odbc and sqlite. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <exclusions>
                <!-- Annotations only, and a newer version than the runtime supplies. The
                     runtime's copy wins on the platform classpath either way. -->
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>checker-qual</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
            <exclusions>
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>12.8.1.jre11</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- redash refuses to start without a cookie secret, and so does this rebuild:
                 the session identity, the invitation tokens and the cross-site token are all
                 derived from it. The tests supply a fixed one so a signature written by one
                 run verifies in the next. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <REDASH_COOKIE_SECRET>probe-cookie-secret</REDASH_COOKIE_SECRET>
                        <REDASH_SECRET_KEY>probe-cookie-secret</REDASH_SECRET_KEY>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <REDASH_COOKIE_SECRET>probe-cookie-secret</REDASH_COOKIE_SECRET>
                        <REDASH_SECRET_KEY>probe-cookie-secret</REDASH_SECRET_KEY>
                        <!-- The same mail settings the original's compose file gives it, so
                             the two sides answer the same `mailSettingsMissing` and the four
                             account emails take the same route. The address is the mail
                             catcher the original's stack already publishes. -->
                        <REDASH_MAIL_SERVER>127.0.0.1</REDASH_MAIL_SERVER>
                        <REDASH_MAIL_PORT>26604</REDASH_MAIL_PORT>
                        <REDASH_MAIL_DEFAULT_SENDER>redash@example.com</REDASH_MAIL_DEFAULT_SENDER>
                        <!-- The periodic jobs are driven directly by their own test rather
                             than on a timer, so that a test which takes longer than a job's
                             interval does not have that job fire underneath it. -->
                        <REDASH_DISABLE_SCHEDULER>true</REDASH_DISABLE_SCHEDULER>
                        <!-- redash's own compose file switches CSRF enforcement on, and its
                             code defaults it off. Every answer recorded from the original
                             was recorded with it on, so this side is compared with it on. -->
                        <REDASH_ENFORCE_CSRF>true</REDASH_ENFORCE_CSRF>
                        <!-- The one external sign-in that needs no third party, and so the
                             one whose whole route can be put to both systems. The original's
                             own stack runs with it on for the same reason, so `/api/config`
                             answers the same on both sides. -->
                        <REDASH_REMOTE_USER_LOGIN_ENABLED>true</REDASH_REMOTE_USER_LOGIN_ENABLED>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <!-- The test kit binds a fixed port and defaults to 39390. Several
                             rebuilds share this machine, and two of them running their
                             integration tests at once both bind it: one wins, the other
                             loses its runtime part-way through and answers 500 to
                             everything after that. This is inside the host-port block allocated to
                             this rebuild. -->
                        <akka.javasdk.testkit.http-port>26610</akka.javasdk.testkit.http-port>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
