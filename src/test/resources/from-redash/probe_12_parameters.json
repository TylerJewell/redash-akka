  "mustache": {
    "plain": {
      "template": "{{a}}",
      "context": {
        "a": "x"
      },
      "render": "x",
      "render_escape": "x"
    },
    "missing": {
      "template": "{{a}}",
      "context": {},
      "render": "",
      "render_escape": ""
    },
    "dotted": {
      "template": "{{a.b}}",
      "context": {
        "a": {
          "b": "x"
        }
      },
      "render": "x",
      "render_escape": "x"
    },
    "section-truthy": {
      "template": "{{#a}}yes{{/a}}",
      "context": {
        "a": true
      },
      "render": "yes",
      "render_escape": "yes"
    },
    "section-falsy": {
      "template": "{{#a}}yes{{/a}}",
      "context": {
        "a": false
      },
      "render": "",
      "render_escape": ""
    },
    "section-list": {
      "template": "{{#a}}[{{.}}]{{/a}}",
      "context": {
        "a": [
          1,
          2
        ]
      },
      "render": "[1][2]",
      "render_escape": "[1][2]"
    },
    "inverted": {
      "template": "{{^a}}none{{/a}}",
      "context": {
        "a": false
      },
      "render": "none",
      "render_escape": "none"
    },
    "needs-escaping": {
      "template": "{{a}}",
      "context": {
        "a": "<b>&'\""
      },
      "render": "<b>&'\"",
      "render_escape": "&lt;b&gt;&amp;&#x27;&quot;"
    },
    "triple-stache": {
      "template": "{{{a}}}",
      "context": {
        "a": "<b>"
      },
      "render": "<b>",
      "render_escape": "<b>"
    },
    "ampersand": {
      "template": "{{&a}}",
      "context": {
        "a": "<b>"
      },
      "render": "<b>",
      "render_escape": "<b>"
    },
    "comment": {
      "template": "x{{! hidden }}y",
      "context": {},
      "render": "xy",
      "render_escape": "xy"
    },
    "literal-braces": {
      "template": "{{a}} }} {{",
      "context": {
        "a": "x"
      },
      "render": "x }} {{",
      "render_escape": "x }} {{"
    },
